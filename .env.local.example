VITE_APP_API_BASE_URL=http://localhost:8080
# Escape de desarrollo: el club se resuelve por hostname contra el catalogo, y esta variable
# solo entra si ese lookup falla (ej. localhost no registrado en club_dominios).
# NO setearla en produccion: ahi serviria el club equivocado si faltara el dominio.
VITE_APP_CLUB_ID=
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_APP_ID=
